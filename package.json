{
  "name": "scoped",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "package:release": "npm run build && npm run validate && node scripts/package-release.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "setup:maps": "node scripts/update-geodata.mjs",
    "setup:search": "node scripts/setup-search.mjs",
    "test:semantic:browser": "node scripts/test-semantic-browser.mjs",
    "test:backup:browser": "node scripts/test-backup-browser.mjs",
    "update:maps": "node scripts/update-geodata.mjs --refresh"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/topojson-client": "^3.1.5",
    "fake-indexeddb": "6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^27.4.0",
    "playwright-core": "1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
